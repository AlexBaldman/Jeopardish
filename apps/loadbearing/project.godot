; Engine configuration file.
; LOADBEARING vertical slice
; Edit through Godot where possible; this file intentionally stays small.

config_version=5

[application]
config/name="LOADBEARING"
config/description="Pixel-art strength training RPG vertical slice"
run/main_scene="res://src/scenes/main.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
